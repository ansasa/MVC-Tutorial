@{
    ViewData["Title"] = "Index";
}
<h1>Index</h1>


<p>
    <a asp-action="Create">Create New</a>
</p>

<div class="container">
    <div style="width:100%; margin:0 auto;">
        <table id="tblEmployees" class="table table-striped table-bordered dt-responsive nowrap" width="100%" cellspacing="0">
            <thead>
                <tr>
                    <th>EmployeeID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Title</th>
                    <th>Birth Date</th>
                    <th>Hire Date</th>
                    <th>Country</th>
                    <th>Department</th>
                    <th>Notes</th>
                    <th>Operations</th>
                </tr>
            </thead>
        </table>
    </div>

</div>

<script>
    $(document).ready(function () {
        $('#tblEmployees').DataTable({
            "processing": true,
            "serverSide": true,
            "filter": true,
            "orderMulti": false,
            "ajax": {
                "url": "/Employees/LoadData",
                "type": "POST",
                "datatype": "json"
            },
            "columnDefs":
                [{
                    "targets": [0],
                    "visible": false,
                    "searchable": false
                }],
            "columns": [
                { "data": "id", "name": "id", "autoWidth": true },
                { "data": "firstName", "name": "firstName", "autoWidth": true },
                { "data": "lastName", "name": "lastName", "autoWidth": true },
                { "data": "title", "name": "title", "autoWidth": true },
                { "data": "birthDate", "name": "birthDate", "autoWidth": true },
                { "data": "hireDate", "name": "hireDate", "autoWidth": true },
                { "data": "countries.countryName", "name": "countries.countryName", "autoWidth": true },
                { "data": "departments.deptName", "name": "departments.deptName", "autoWidth": true },
                { "data": "notes", "name": "notes", "autoWidth": true },

                 {
                    "data": "id",
                    "render": function (data) {
                        return `
                            <div class="text-center">
                                <a href="/Employees/Details/${data}" class="btn btn-success text-white" style="cursor:pointer">
                                    Details
                                </a>
                                <a href="/Employees/Edit/${data}" class="btn btn-success text-white" style="cursor:pointer">
                                    Edit
                                </a>

                                <a href="/Employees/Delete/${data}" class="btn btn-success text-white" style="cursor:pointer">
                                    Delete
                                </a>

                               
                            </div>
                           `;
                    }, "width": "30%"
                }



                ]

        });

    });
</script>


